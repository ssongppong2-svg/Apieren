{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "apieren:spark",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/apieren_glow"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.max(1, v.count)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "v.spread",
        "direction": [
          "math.random(-1, 1)",
          "math.random(-1, 1) + v.up",
          "math.random(-1, 1)"
        ]
      },
      "minecraft:particle_initial_speed": "v.speed * (0.45 + v.particle_random_1 * 0.8)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.max(0.1, v.life) * (0.6 + v.particle_random_2 * 0.6)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          "-v.gravity",
          0
        ],
        "linear_drag_coefficient": "v.drag"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "math.max(0.02, v.size) * (1 - v.particle_age / v.particle_lifetime)",
          "math.max(0.02, v.size) * (1 - v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.color.r",
          "v.color.g",
          "v.color.b",
          "1"
        ]
      }
    }
  }
}
